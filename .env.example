# Only needed for local testing with `netlify dev`.
# On the live site, add these in Netlify -> Site settings -> Environment variables.
TURSO_DATABASE_URL=libsql://your-db-name-your-org.turso.io
TURSO_AUTH_TOKEN=
GEMINI_API_KEY=
ADMIN_PASSWORD=
SESSION_SECRET=
# Optional
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_THINKING=medium
